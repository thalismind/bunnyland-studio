ARG BUNNYLAND_WEB_IMAGE=ghcr.io/thalismind/bunnyland-web:main

FROM node:24-bookworm@sha256:5711a0d445a1af54af9589066c646df387d1831a608226f4cd694fc59e745059 AS studio-build
WORKDIR /src
COPY package.json package-lock.json ./
COPY web/package.json ./web/package.json
RUN npm ci
COPY web/ ./web/
RUN npm --workspace web run build

FROM ${BUNNYLAND_WEB_IMAGE}
COPY --from=studio-build /src/web/dist/ /usr/share/nginx/html/studio/
